# NAI2T Luzy backend — copy to .env for local dev; on Render set these in the dashboard.

# REQUIRED. The Anthropic API key. Lives ONLY here / in Render env — never sent to the browser.
ANTHROPIC_API_KEY=

# Model for Luzy's main loop. Defaults to the latest Opus.
LUZY_MODEL=claude-opus-5
# Cheaper model for delegated sub-agents.
SUBAGENT_MODEL=claude-haiku-4-5
# Effort: low | medium | high | xhigh | max
LUZY_EFFORT=high

# Sandbox workspace root — the ONLY directory tools may touch. Created if missing.
WORKSPACE_DIR=./workspace

# Comma-separated origins allowed to open the WebSocket (your Netlify site).
ALLOWED_ORIGINS=http://localhost:8888,https://nai2t.netlify.app

# Limits
CMD_TIMEOUT_MS=60000
MAX_OUTPUT_BYTES=200000
MAX_TURNS=24

PORT=8787
